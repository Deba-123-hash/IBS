# ===================================================
# CampusOS / UNIFIX TECH — Environment Configuration
# ===================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require"

# JWT Secrets & Expiry
JWT_SECRET="your-256-bit-jwt-secret-key-here"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="your-256-bit-refresh-secret-key-here"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Frontend / CORS Origin
CLIENT_URL="http://localhost:5173"
VITE_API_URL="http://localhost:5000/api/v1"

# AI Assistant Integration (Groq or Gemini)
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
GEMINI_API_KEY=""

# Cloudinary Storage (Optional for attachments)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

