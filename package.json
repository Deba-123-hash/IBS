{
  "name": "campus-life-debugged",
  "version": "1.0.0",
  "description": "Unified Campus Operations OS - Attendance, Mess, Hostel, Repeat: Campus Life, Debugged",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npx --yes concurrently -k \"npm run server\" \"npm run client\"",
    "client": "npm run dev --workspace=client",
    "server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "db:generate": "npm run prisma:generate --workspace=server",
    "db:migrate": "npm run prisma:migrate --workspace=server",
    "db:seed": "npm run seed --workspace=server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "health": "node scripts/health-check.js",
    "setup": "node scripts/setup.js",
    "test": "node scripts/verify-phases.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "campus-os",
    "hostel-management",
    "attendance",
    "fretbox",
    "hackathon",
    "education-tech"
  ],
  "author": "Fretbox Campus OS Team",
  "license": "MIT"
}
