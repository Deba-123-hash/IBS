PORT=5000
NODE_ENV=development

# Neon Serverless PostgreSQL connection string
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secrets & Expiry
JWT_SECRET="super-secret-campus-life-debugged-jwt-key-2026"
JWT_EXPIRES_IN="15m"

REFRESH_TOKEN_SECRET="super-secret-campus-life-debugged-refresh-key-2026"
REFRESH_TOKEN_EXPIRES_IN="7d"

# AI Provider Configuration (Groq)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
GROQ_TEMPERATURE="0.2"
GROQ_MAX_TOKENS="1024"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Frontend Client URL / Allowed CORS Origin
CLIENT_URL="http://localhost:5173"

# Demo Admin Credentials (Optional overrides for development/demo environment)
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
